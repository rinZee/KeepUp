{
  "name": "keepup-community-space",
  "version": "1.0.0",
  "description": "A virtual community space for discovering local music events by venue.",
  "main": "server.js",
  "scripts": {
    "build": "esbuild client/src/main.jsx --bundle --outfile=public/app.js --platform=browser --format=iife --minify",
    "start": "npm run build && node server.js",
    "dev": "npm run build && node --watch server.js",
    "test": "node --test"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^4.19.2",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
